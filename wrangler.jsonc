// Cloudflare deploy for https://neovain.dev: the site/ folder served as static assets.
// Deploy with `npx wrangler deploy` from the repository root.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neovain",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "site",
    // Unknown paths get 404.html with a 404 status instead of the home page.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "neovain.dev", "custom_domain": true }],
  // One public address only, so search engines never see a duplicate of the site.
  "workers_dev": false,
  "preview_urls": false
}
